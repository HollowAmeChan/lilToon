        //----------------------------------------------------------------------------------------------------------------------
        // Advanced
        // 逐字复制 DefaultOpaque.lilblock 的前 30 行，唯一区别：_Cull 默认值 2 -> 0
        // 液体必须双面渲染（正面=液体本体，背面=液面下层），漏掉这一段或不改默认值
        // 会表现为「材质一片空白」或「只剩一面」，且 Unity 不报任何错。
        [lilEnum]                                       _Cull               ("sCullModes", Int) = 0
        [Enum(UnityEngine.Rendering.BlendMode)]         _SrcBlend           ("sSrcBlendRGB", Int) = 1
        [Enum(UnityEngine.Rendering.BlendMode)]         _DstBlend           ("sDstBlendRGB", Int) = 0
        [Enum(UnityEngine.Rendering.BlendMode)]         _SrcBlendAlpha      ("sSrcBlendAlpha", Int) = 1
        [Enum(UnityEngine.Rendering.BlendMode)]         _DstBlendAlpha      ("sDstBlendAlpha", Int) = 10
        [Enum(UnityEngine.Rendering.BlendOp)]           _BlendOp            ("sBlendOpRGB", Int) = 0
        [Enum(UnityEngine.Rendering.BlendOp)]           _BlendOpAlpha       ("sBlendOpAlpha", Int) = 0
        [Enum(UnityEngine.Rendering.BlendMode)]         _SrcBlendFA         ("sSrcBlendRGB", Int) = 1
        [Enum(UnityEngine.Rendering.BlendMode)]         _DstBlendFA         ("sDstBlendRGB", Int) = 1
        [Enum(UnityEngine.Rendering.BlendMode)]         _SrcBlendAlphaFA    ("sSrcBlendAlpha", Int) = 0
        [Enum(UnityEngine.Rendering.BlendMode)]         _DstBlendAlphaFA    ("sDstBlendAlpha", Int) = 1
        [Enum(UnityEngine.Rendering.BlendOp)]           _BlendOpFA          ("sBlendOpRGB", Int) = 4
        [Enum(UnityEngine.Rendering.BlendOp)]           _BlendOpAlphaFA     ("sBlendOpAlpha", Int) = 4
        [lilToggle]                                     _ZClip              ("sZClip", Int) = 1
        [lilToggle]                                     _ZWrite             ("sZWrite", Int) = 1
        [Enum(UnityEngine.Rendering.CompareFunction)]   _ZTest              ("sZTest", Int) = 4
        [IntRange]                                      _StencilRef         ("Ref", Range(0, 255)) = 0
        [IntRange]                                      _StencilReadMask    ("ReadMask", Range(0, 255)) = 255
        [IntRange]                                      _StencilWriteMask   ("WriteMask", Range(0, 255)) = 255
        [Enum(UnityEngine.Rendering.CompareFunction)]   _StencilComp        ("Comp", Float) = 8
        [Enum(UnityEngine.Rendering.StencilOp)]         _StencilPass        ("Pass", Float) = 0
        [Enum(UnityEngine.Rendering.StencilOp)]         _StencilFail        ("Fail", Float) = 0
        [Enum(UnityEngine.Rendering.StencilOp)]         _StencilZFail       ("ZFail", Float) = 0
                                                        _OffsetFactor       ("sOffsetFactor", Float) = 0
                                                        _OffsetUnits        ("sOffsetUnits", Float) = 0
        [lilColorMask]                                  _ColorMask          ("sColorMask", Int) = 15
        [lilToggle]                                     _AlphaToMask        ("sAlphaToMask", Int) = 0
                                                        _lilShadowCasterBias ("Shadow Caster Bias", Float) = 0

        //----------------------------------------------------------------------------------------------------------------------
        // Liquid
        [lilToggleLeft] _UseLiquid               ("sLiquid", Int) = 1
        [lilEnum]       _LiquidSurfaceMode       ("sLiquidSurfaceModes", Int) = 0
                        _LiquidSurfaceWidth      ("sLiquidSurfaceWidth", Range(0, 0.5)) = 0.06

        //----------------------------------------------------------------------------------------------------------------------
        // Liquid - Specular（液面高光）
        // 为什么需要单独一项：容器壁的多边形法线是**水平指向外**的，用它算反射/高光，
        // 液面上会出现一圈"贴着容器壁"的错高光。这里把反射模块专用的法线
        // （fd.reflectionN，只影响反射/高光，不影响阴影与软切）换成液面平面法线，
        // 高光才会像一块平静的水面。强度 0 = 关闭，用网格原法线。
        // 注意：还要在 Reflection 段里开 _UseReflection + 提高 _Smoothness 才看得到效果。
                        _LiquidSpecularStrength  ("sLiquidSpecularStrength", Range(0, 1)) = 1

        //----------------------------------------------------------------------------------------------------------------------
        // Liquid - Level
        // _LiquidFill(0..1) 在 _LiquidLevelY 与 _LiquidLevelH 两个「网格本地 Y」之间线性插值出液面。
        // （uniform 名字保持 _LiquidLevelY / _LiquidLevelH；面板显示名走 sLiquidLevelBottom / sLiquidLevelTop）
        // 默认 -0.5 / 0.5 = Unity 默认正方体的本地 Y 上下界，所以开箱即用是满量程。
        // 换成其它模型时把这两个值改成该网格竖直方向的本地 Y 上下界（模型从 Blender 导入时很容易是 0..2 之类）。
        // 关键：这两个值的差值就是「液面能走的整个范围」。差得太小，滑条就几乎调不动。
                        _LiquidFill              ("sLiquidFill", Range(0, 1)) = 0.5
                        _LiquidLevelY            ("sLiquidLevelBottom", Float) = -0.5
                        _LiquidLevelH            ("sLiquidLevelTop", Float) = 0.5

        //----------------------------------------------------------------------------------------------------------------------
        // Liquid - Tilt
        // 两轴倾斜（度）。语义按「坡度方向」命名：_LiquidTiltX = +x 侧液面抬高，_LiquidTiltZ = +z 侧液面抬高。
        // 不要直接喂 transform.eulerAngles —— 反解式见设计文档 §4.5。
        // 「容器倒过来」由 shader 里的 lilLiquidInteriorSign() 自动换内部，见 §4.6。
                        _LiquidTiltX            ("sLiquidTiltX", Range(-90, 90)) = 0
                        _LiquidTiltZ            ("sLiquidTiltZ", Range(-90, 90)) = 0
                        _LiquidTiltScale        ("sLiquidTiltScale", Range(0, 4)) = 1
                        // 脚本输入量：液面垂直偏移，范围 ±1（与倾斜正交，单独一路）
                        // 模式 0 `Absolute` = 网格本地单位；模式 1 `Range %` = 液面量程的百分比
                        _LiquidOffset           ("sLiquidOffset", Range(-1, 1)) = 0
        [lilEnum]       _LiquidOffsetMode       ("sLiquidOffsetModes", Int) = 0

        //----------------------------------------------------------------------------------------------------------------------
        // Liquid - Wave（液面波纹；不影响 _LiquidFill 的中位高度）
        // 正面的波纹是"被驱动"的：容器不动时 _LiquidWaveAmp 给 0 就没有波纹。
                        _LiquidWaveAmp           ("sLiquidWaveAmp", Range(0, 0.2)) = 0
                        _LiquidWaveFreq          ("sLiquidWaveFreq", Range(0.1, 40)) = 8
                        _LiquidWaveSpeed         ("sLiquidWaveSpeed", Range(-5, 5)) = 1
        [lilEnum]       _LiquidWaveSpace         ("sLiquidWaveSpaces", Int) = 0

        //----------------------------------------------------------------------------------------------------------------------
        // Liquid - Underlay（液面**下层**的常态流动层）
        //
        // 只在 _LiquidSurfaceMode = 1 时可见：那时背面会被推出去一圈，那一圈就是"液面下层"。
        // 参考实现（41水瓶 Liquid.shader）在背面用的是 tex2D(_B, 滚动UV) + _TopColor，
        // 也就是**一层持续滚动的贴图** —— 与液面波纹无关，所以容器静止时下层依然在流动。
        // 本实现照这个思路，但 UV 从屏幕空间换成**物体空间**（屏幕空间转视角会飘，VR 里更明显）。
        //
        // 与纹波的分工：
        //   _LiquidWave*  = 被驱动的高度场（容器静止 → 幅度给 0 → 液面变平）
        //   _LiquidUnderlay* = 常态流动的贴图层（永远在动）
        //   两者叠起来就是"平的水面底下还有东西在缓慢翻涌"。
        //
        // 贴图的 alpha 当遮罩（0 = 不显示下层），所以可以拿一张 RGBA 图控制"哪里看得见下层"。
        // 不加 [NoScaleOffset]：着色器要读 _LiquidUnderlayTex_ST 做平铺/偏移。
                        _LiquidUnderlayTex      ("sLiquidUnderlayTex", 2D) = "black" {}
        [lilHDR]        _LiquidUnderlayColor    ("sColor", Color) = (0.35,0.55,0.65,0.5)
                        _LiquidUnderlayScroll   ("sLiquidUnderlayScroll", Vector) = (0.08,0.03,0,0)
